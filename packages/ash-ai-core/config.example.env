# Names only. Do not put real keys in this file.
# A product passes these into the provider constructors. ASH AI Core does not read this file itself.

# Local loopback only. Leave empty to skip Ollama.
ASH_AI_OLLAMA_URL=http://127.0.0.1:11434

# Optional free-tier cloud keys. Empty means that provider is not registered.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. Set to 0 to skip OCR during PDF extraction.
ASH_AI_OCR=1
