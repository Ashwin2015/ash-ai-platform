# Copy to .env.local. Keep the bootstrap key private and out of Git.
# Hosted (Render) secrets belong in the Render dashboard, not this file.
ASH_PLATFORM_HOST=127.0.0.1
ASH_PLATFORM_PORT=3035
ASH_PLATFORM_DATABASE=.data/ash-platform.sqlite
ASH_PLATFORM_FILES=.data/files
# Unused by the server. Kept so an existing hosted value does not fail config load.
ASH_PLATFORM_BOOTSTRAP_KEY=
# When set, new registration must send this code. Existing accounts can still sign in. Leave empty for open local registration.
ASH_PLATFORM_INVITE_CODE=
ASH_PLATFORM_SESSION_HOURS=12
ASH_PLATFORM_SERVE_CHAT=1
# Hosted HTTPS origin only. Leave empty for local loopback.
# ASH_PLATFORM_PUBLIC_ORIGIN=https://chat.example.com
# ASH_PLATFORM_HOST=0.0.0.0
ASH_PLATFORM_AUTO_INSTALL_MODELS=1
ASH_PLATFORM_OCR=1

# Ollama must be local to this platform process.
ASH_PLATFORM_OLLAMA_URL=http://127.0.0.1:11434

# Optional free-tier cloud providers. Leave empty to keep inference local.
# Do not copy keys from other products automatically.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Hosted only (Render + Supabase). Leave empty on this PC.
# DATABASE_URL=
# SUPABASE_URL=https://pqrzjwynarkbadzbpuvw.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=ash-private-files
# ASH_PLATFORM_PUBLIC_ORIGIN=https://YOUR-RENDER-SERVICE.onrender.com
# ASH_CHAT_PUBLIC_ORIGIN=
# ASH_PLATFORM_APPLY_MIGRATIONS=0
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ASH Chat frontend
ASH_CHAT_HOST=127.0.0.1
ASH_CHAT_PORT=3036
ASH_CHAT_API_ORIGIN=http://127.0.0.1:3035

# Optional later LAN HTTPS (do not expose publicly)
# ASH_AI_TLS_HOST=192.168.1.20
# ASH_AI_TLS_PORT=3443
# ASH_AI_TLS_PFX=
# ASH_AI_TLS_PFX_PASSPHRASE=
